            <damping>0.025</damping>
          </dynamics>
        </axis>
      </joint>
      <link name="front_right_wheel">
        <pose>0.578169122 -0.344960215 0.110066672 0 0 0</pose>
        <inertial>
          <mass>0.91</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia>
            <ixx>0.0057</ixx>
            <iyy>0.0096</iyy>
            <izz>0.0057</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="tire_collision">
          <pose>0 0 0 1.57079633 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.110066672</radius>
              <length>0.0884766653</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.15</mu>
                <mu2>1.15</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="cad_wheel_visual">
          <pose>0 0 0 0 0 3.14159265</pose>
          <geometry>
            <mesh>
              <uri>ring_assets/cad-wheel.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.075 0.08 0.09 1</ambient>
            <diffuse>0.075 0.08 0.09 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <topic>/cart/contacts/front_right_wheel</topic>
          <always_on>true</always_on>
          <update_rate>250</update_rate>
          <contact>
            <collision>tire_collision</collision>
            <topic>/cart/contacts/front_right_wheel</topic>
          </contact>
        </sensor>
      </link>
      <joint name="front_right_wheel_joint" type="revolute">
        <parent>right_knuckle</parent>
        <child>front_right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
            <effort>0</effort>
            <velocity>105</velocity>
          </limit>
          <dynamics>
            <damping>0.004</damping>
          </dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <left_steering_joint>left_steering_joint</left_steering_joint>
        <right_steering_joint>right_steering_joint</right_steering_joint>
        <wheel_radius>0.110066672</wheel_radius>
        <wheel_base>0.578169122</wheel_base>
        <wheel_separation>0.68992043</wheel_separation>
        <kingpin_width>0.68992043</kingpin_width>
        <steering_limit>0.48</steering_limit>
        <steer_p_gain>13</steer_p_gain>
        <min_velocity>-2</min_velocity>
        <max_velocity>12</max_velocity>
        <min_acceleration>-3.6</min_acceleration>
        <max_acceleration>2.3</max_acceleration>
        <topic>/model/cart/cmd_vel</topic>
        <odom_topic>/model/cart/wheel_odometry</odom_topic>
        <tf_topic>/model/cart/wheel_tf</tf_topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_frame>world</odom_frame>
        <robot_base_frame>cart/base_link</robot_base_frame>
        <odom_topic>/model/cart/odometry</odom_topic>
        <tf_topic>/model/cart/odometry_tf</tf_topic>
        <odom_publish_frequency>250</odom_publish_frequency>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>true</publish_link_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>-1</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>